# OCToPUS Snakemake Pipeline — Configuration
# Copy this file to config/config.yaml and fill in your paths.
# config/config.yaml is gitignored — only this example is tracked.

# Output run identifier — results go to results/<run_id>/
# Set explicitly for reproducible naming; default: ISO timestamp.
run_id: "my_run"

# Path to samples TSV file (tab-separated: SampleID  R1.fastq  R2.fastq)
samples: "config/samples.tsv"

# Full absolute path to SILVA reference FASTA (mothur-compatible)
# Download: http://www.mothur.org/wiki/Silva_reference_files
reference: "/full/path/to/silva.bacteria.fasta"

# Full absolute path to USEARCH 8.1.1861 executable
# Must be supplied by the user — license prevents redistribution.
# Download: http://www.drive5.com/usearch/
usearch: "/full/path/to/usearch8.1.1861"

# Number of CPU cores to use per tool invocation
processors: 8

# mothur QC parameters (these are the original OCToPUS defaults)
mothur:
  maxambig: 0
  maxhomop: 8
  minlength: 200
  align_criteria: 95

# UPARSE clustering parameters (original OCToPUS defaults)
uparse:
  min_size: 2
  identity: 0.97
